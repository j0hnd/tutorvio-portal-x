APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=tutorvio
DB_USERNAME=tutorvio
DB_PASSWORD=tutorvio_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=120

L5_SWAGGER_API_TITLE="Tutorvio Portal API"
L5_SWAGGER_API_VERSION=1.0.0
L5_SWAGGER_API_DESCRIPTION="Tutorvio Portal API documentation for authenticated portal workflows."
L5_SWAGGER_CONST_HOST=http://localhost:8001
L5_SWAGGER_ALLOWED_ENVIRONMENTS=local,testing
L5_SWAGGER_ALLOW_PRODUCTION=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CHAT_ALLOW_TEACHER_MESSAGE_PINS=true
CHAT_ALLOW_STUDENT_MESSAGE_PINS=false
CHAT_REALTIME_ENABLED=true
CHAT_REALTIME_CACHE_STORE=redis
CHAT_REALTIME_KEY_NAMESPACE=tvio:chat
CHAT_TYPING_TTL_SECONDS=10
CHAT_PRESENCE_TTL_SECONDS=60
CHAT_ACTIVE_CONVERSATION_TTL_SECONDS=120
CHAT_UNREAD_COUNT_TTL_SECONDS=30
CHAT_DUPLICATE_REMINDER_LOCK_TTL_SECONDS=300
CHAT_DELIVERY_STATUS_TTL_SECONDS=86400
CHAT_RATE_LIMIT_DECAY_SECONDS=60

CACHE_STORE=redis
RATE_LIMITER_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis is optional locally. QUEUE_CONNECTION=redis expects a Redis service;
# set CACHE_STORE/RATE_LIMITER_STORE=redis only when Redis-backed caching and
# rate limiting are also required.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_LOCK_DB=3
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=lock
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=null

LESSON_BOOKING_LOCK_STORE=redis
LESSON_BOOKING_LOCK_TTL_SECONDS=60

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
